# --- LLM provider -----------------------------------------------------------
# One of: anthropic | openai | google | scripted
# "openai" also drives any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio,
# OpenRouter, Together, Groq, DeepSeek) via HOI4_LLM_BASE_URL.
HOI4_LLM_PROVIDER=anthropic
HOI4_LLM_MODEL=claude-opus-5
# HOI4_LLM_BASE_URL=http://localhost:11434/v1
HOI4_LLM_MAX_TOKENS=16000
HOI4_LLM_EFFORT=high
HOI4_LLM_TEMPERATURE=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Game bridge ------------------------------------------------------------
# One of: mock | savegame | screen
HOI4_ADAPTER=mock
# Who owns the game clock: harness | player. Use `player` when a person is
# playing the same campaign - the harness then never pauses or sets speed.
HOI4_CLOCK_OWNER=harness
HOI4_SAVE_DIR=
HOI4_WINDOW_TITLE=Hearts of Iron IV
# Refuse to send keyboard/mouse input unless the game is the focused window.
HOI4_ENFORCE_WINDOW_FOCUS=1

# --- Loop -------------------------------------------------------------------
HOI4_MAX_ACTIONS_PER_TURN=8
HOI4_TICK_SECONDS=5
HOI4_RUN_DIR=runs
HOI4_DRY_RUN=1

# --- What the model is told -------------------------------------------------
# Built-in packs: none | unconstrained | minimal | doctrine | historical | coach
# ...or a path to your own markdown file.
HOI4_GUIDANCE=doctrine
# HOI4_SYSTEM_PROMPT=./my-system-prompt.txt     # replaces the prompt entirely
# HOI4_SYSTEM_PROMPT_EXTRA=
# HOI4_OBJECTIVE=

# --- What the model may do --------------------------------------------------
HOI4_REQUIRE_CONFIRMATION=1
HOI4_MAX_TOOL_ROUNDS=3
# Consecutive provider failures tolerated before the run stops.
HOI4_MAX_CONSECUTIVE_LLM_ERRORS=5
# HOI4_PLANNER_ENABLED=0                     # reflex-only: never wake the model; the baseline

# --- Game start (mock adapter) ----------------------------------------------
HOI4_COUNTRY=SWE
HOI4_START_DATE=1936-01-01
HOI4_SEED=1936
HOI4_TURNS=10
HOI4_DAYS_PER_TURN=7
HOI4_FULL_BRIEF_EVERY=8

# --- Ceilings ---------------------------------------------------------------
HOI4_MAX_LLM_CALLS=250
# HOI4_MAX_USD=2.0
# HOI4_USD_PER_M_INPUT=5.0
# HOI4_USD_PER_M_OUTPUT=25.0

